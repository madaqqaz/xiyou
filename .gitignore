# 生成的脚本（临时）
_*.ps1
_*.js
# 门禁/审计脚本在 scripts/ 与 tools/ 下，属项目资产，必须纳管（历史踩坑：整目录被忽略导致全灭无法恢复）
!scripts/_*.js
!tools/_*.js
_*.cjs

# 缓存目录
.cache/
.parcel-cache/
.eslintcache

# 测试覆盖率
coverage/
.nyc_output/

# 工作目录（agent临时文件）
.workbuddy/

# ========== 以下为PWA部署优化，减少仓库大小 ==========

# 开发文档（不需要部署到GitHub Pages）
docs/
# 设计文档是项目资产，md 类必须纳管（大体积 docx/png 仍忽略）
!docs/*.md

# 微信小游戏版本（独立项目）
minigame/

# 平台适配层（PWA用browser.js即可，其他不需要）
platform/

# 战斗精灵预览（开发工具）
combat_sprite/

# 原始音频文件（有mp3版本即可，wav太大）
assets/sound/raw/

# 云flare工具（太大，不需要）
cloudflared.exe
